# PostgreSQL (Neon) — the app uses raw SQL via the `pg` driver (no ORM at runtime).
# Paste your Neon connection string here; prefer the "pooled" one (host has "-pooler").
# SSL is enforced in code (lib/db.ts), so no sslmode param is needed in the URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb"

# Local SQLite is no longer used; kept only as a historical note:
# DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="your-secret-key-change-this"

# Admin Account
ADMIN_EMAIL="admin@arandelle.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Arandelle"

# Site URLs
NEXT_PUBLIC_SITE_URL="https://arandelle.com"
ADMIN_SUBDOMAIN="dev"
